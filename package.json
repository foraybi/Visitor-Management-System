{
  "name": "vms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:api": "node --watch --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx server/index.ts",
    "db:start": "supabase start -x imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:env": "node scripts/write-local-env.mjs",
    "seed:local": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed-local.mjs",
    "smoke:roles": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/smoke-roles.mjs",
    "check:cloud": "node --env-file-if-exists=.env scripts/check-cloud.mjs",
    "seed:cloud": "node --env-file-if-exists=.env scripts/seed-local.mjs --allow-remote",
    "smoke:cloud": "node --env-file-if-exists=.env scripts/smoke-roles.mjs",
    "build": "tsc -b && vite build",
    "build:kiosk": "tsc -b && VITE_APP_TARGET=kiosk vite build",
    "build:staff": "tsc -b && VITE_APP_TARGET=staff vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/index.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/index.mjs",
    "preview:kiosk": "npm run build:kiosk && npm run build:server && APP_TARGET=kiosk PORT=4174 node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/index.mjs",
    "verify:kiosk": "bash scripts/verify-build.sh kiosk",
    "verify:staff": "bash scripts/verify-build.sh staff",
    "flush-data": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/flush-data.mjs",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.1.1",
    "@supabase/supabase-js": "^2.106.0",
    "antd": "^6.3.6",
    "dayjs": "^1.11.23",
    "howler": "^2.2.4",
    "i18next": "^26.0.6",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.4",
    "react-router-dom": "^6.30.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-sounds": "^1.0.30",
    "react-timer-hook": "^4.0.6",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-signature-canvas": "^1.0.7",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "qrcode": "^1.5.4",
    "supabase": "^2.117.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
