# ─────────────────────────────────────────────────────────────────────────────
# Which app this deployment serves: kiosk or staff
# ─────────────────────────────────────────────────────────────────────────────
VITE_APP_TARGET=staff

# ─────────────────────────────────────────────────────────────────────────────
# Browser (staff app only). Inlined into the bundle by Vite, which is correct:
# the publishable key is meant to be public and Row Level Security decides access.
# Leave these UNSET on the kiosk deployment; the tablet holds no database key.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# ─────────────────────────────────────────────────────────────────────────────
# Server only (both deployments). Read by api/ and server/, never bundled.
#
# NEVER add a VITE_ prefix to the service role key. Vite would inline it into
# the browser bundle and hand every visitor full database access.
#
# After moving to a self-hosted server, point SUPABASE_URL (and VITE_SUPABASE_URL)
# at it, for example http://10.0.0.5:8000. Nothing else changes.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Self-hosted server (npm start)
# PORT=8787
# STATIC_DIR=dist
